NODE_ENV=development
PORT=3000
HOST=127.0.0.1

POSTGRES_DB=real_time_chat
POSTGRES_USER=chat_local
# Generate a local password before starting Compose; never commit .env.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Fill with matching POSTGRES_* values; URL-encode user/password if needed.
DATABASE_URL=
# Separate disposable database for integration tests, never the development DB.
TEST_DATABASE_URL=
