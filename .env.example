NODE_ENV=development
PORT=3000
HOST=127.0.0.1

POSTGRES_DB=real_time_chat
POSTGRES_USER=chat_local
# Generate a local password before starting Compose; never commit .env.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
WEB_PORT=8080
# Exact browser origin; change together with WEB_PORT or when using host Angular.
# For localhost use http://localhost:8080; do not mix localhost and 127.0.0.1.
# HTTP and Socket.IO share this origin and the same HttpOnly session cookie.
APP_ORIGIN=http://127.0.0.1:8080
# Absolute session lifetime: 1–604800 seconds (default 24 hours).
SESSION_TTL_SECONDS=86400
# Sliding quotas per send/10s USER, login/minute IP, register/hour IP, channel/hour USER.
# Integers 1–1000; attempts include validation failures and message retries.
SEND_LIMIT=30
TYPING_LIMIT=10
PRESENCE_LIMIT=20
LOGIN_LIMIT=10
REGISTER_LIMIT=5
CHANNEL_CREATE_LIMIT=10
SESSION_CONNECTION_LIMIT=5
# Host API: empty trusts no proxy. List exact peer IPs only, never true or hop counts.
TRUSTED_PROXY_IPS=
# Compose overrides TRUSTED_PROXY_IPS with its web peer. Change these together
# if this subnet overlaps another Docker/local network; Docker validates membership.
BACKEND_SUBNET=172.29.0.0/24
PROXY_IP=172.29.0.254

# Fill with matching POSTGRES_* values; URL-encode user/password if needed.
DATABASE_URL=
# Separate disposable database for integration tests, never the development DB.
TEST_DATABASE_URL=

# Optional tools-profile seed. Choose separate local-only 15–128-character passphrases.
# Never reuse personal passwords. Required only when explicitly running seed.
# Accounts: alice@demo.example.test and bob@demo.example.test. Reruns do not rotate passwords.
DEMO_ALICE_PASSWORD=
DEMO_BOB_PASSWORD=
