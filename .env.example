NODE_ENV=development
PORT=3000
HOST=127.0.0.1

POSTGRES_DB=real_time_chat
POSTGRES_USER=chat_local
# Generate a local password before starting Compose; never commit .env.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
WEB_PORT=8080
# Exact browser origin; change together with WEB_PORT or when using host Angular.
# For localhost use http://localhost:8080; do not mix localhost and 127.0.0.1.
# HTTP and Socket.IO share this origin and the same HttpOnly session cookie.
APP_ORIGIN=http://127.0.0.1:8080
# Absolute session lifetime: 1–604800 seconds (default 24 hours).
SESSION_TTL_SECONDS=86400

# Fill with matching POSTGRES_* values; URL-encode user/password if needed.
DATABASE_URL=
# Separate disposable database for integration tests, never the development DB.
TEST_DATABASE_URL=
