generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  displayName  String
  passwordHash String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  channels     Channel[]
  memberships  Membership[]
  messages     Message[]
  readCursors  ReadCursor[]
}

model Channel {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique @db.VarChar(48)
  name         String       @db.VarChar(80)
  nameKey      String       @unique @db.VarChar(160)
  createdBy    String       @db.Uuid
  creator      User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  lastSequence BigInt       @default(0)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  memberships  Membership[]
  messages     Message[]
  readCursors  ReadCursor[]
}

model Message {
  id              String   @id @default(uuid()) @db.Uuid
  channelId       String   @db.Uuid
  authorId        String   @db.Uuid
  clientMessageId String   @db.Uuid
  sequence        BigInt
  body            String   @db.VarChar(2000)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Restrict)
  author          User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([authorId, clientMessageId])
  @@unique([channelId, sequence])
}

model Membership {
  userId    String   @db.Uuid
  channelId String   @db.Uuid
  joinedAt  DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@id([userId, channelId])
  @@index([channelId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model ReadCursor {
  userId           String  @db.Uuid
  channelId        String  @db.Uuid
  lastReadSequence BigInt  @default(0)
  user             User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  channel          Channel @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@id([userId, channelId])
  @@index([channelId])
}
