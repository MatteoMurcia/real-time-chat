{
  "name": "@real-time-chat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js",
    "db:generate": "npm run prisma -- generate",
    "db:migrate:dev": "npm run prisma -- migrate dev",
    "db:migrate:deploy": "npm run prisma -- migrate deploy",
    "prebuild": "npm run build --workspace @real-time-chat/contracts && npm run db:generate",
    "pretypecheck": "npm run build --workspace @real-time-chat/contracts && npm run db:generate",
    "pretest": "npm run build --workspace @real-time-chat/contracts && npm run db:generate",
    "pretest:integration": "npm run build --workspace @real-time-chat/contracts && npm run db:generate",
    "test:integration": "tsc -p tsconfig.test.json && node --env-file-if-exists=../../.env --test dist-test/test/integration/*.spec.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start:watch": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.spec.js"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.3"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/websockets": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@real-time-chat/contracts": "0.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3"
  }
}
