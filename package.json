{
  "name": "real-time-chat",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time team chat portfolio project",
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": "24.21.0",
    "npm": "12.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "toolchain:versions": "node --version && npm --version && tsc --version",
    "build": "npm run build --workspace @real-time-chat/api",
    "start": "npm start --workspace @real-time-chat/api",
    "typecheck": "npm run typecheck --workspace @real-time-chat/api",
    "test": "npm test --workspace @real-time-chat/api"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
